{
  "name": "dmMiniPlayer",
  "version": "0.6.62",
  "license": "MIT",
  "author": "apades",
  "type": "module",
  "private": true,
  "engines": {
    "pnpm": ">=10.0.0",
    "node": ">=24.11.0"
  },
  "scripts": {
    "predev": "pnpm auto-use-node",
    "dev": "cross-env NODE_ENV=development nodemon --exec \"rm -rf dist && run-p dev:*\"",
    "dev:esm": "tsup --config scripts/dev.tsup.esm.ts",
    "dev:hmr": "vite --config scripts/dev.vite.hmr.ts",
    "prebuild": "pnpm auto-use-node",
    "build": "cross-env NODE_ENV=production run-s build:*",
    "build:esm-chunks": "tsup --config scripts/prod.tsup.esm-chunks.ts --metafile && mv ./dist/metafile-esm.json ./dist/metafile-esm-chunks.json",
    "build:iife": "tsup --config scripts/prod.tsup.iife.ts --metafile",
    "build:clean": "rm ./dist/icon-* && mv dist/metafile-*.json ./",
    "build:after-clean": "tsx scripts/afterClean.ts",
    "playground": "run-s playground:*",
    "playground:build-ext": "cross-env NODE_ENV=test run-s build:*",
    "playground:start": "sh ./scripts/run-playground.sh",
    "release": "node ./scripts/release.mjs",
    "archive": "node ./scripts/archive.mjs",
    "sizetest": "pnpm build && pnpm archive --size-test",
    "translate": "tsx ./scripts/auto-translate.ts",
    "eslint": "npx eslint",
    "update-deps": "pnpm update --depth Infinity",
    "auto-use-node": "sh ./scripts/nvm-auto-use.sh"
  },
  "devDependencies": {
    "@apad/env-tools": "^1.0.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@chialab/esbuild-plugin-meta-url": "^0.19.2",
    "@playwright/test": "^1.62.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "0.2.2",
    "@types/color": "^4.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/less": "^3.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "0.9.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^6.0.0",
    "cross-env": "^10.1.0",
    "enquirer": "^2.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.0",
    "globals": "^17.8.0",
    "https-proxy-agent": "^9.1.0",
    "less": "^4.8.1",
    "lodash-es": "^4.18.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.23",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "protobufjs": "^7.6.5",
    "tailwindcss": "^3.4.19",
    "tailwindcss-rem-to-px": "^0.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "type-fest": "^5.8.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@apad/element-picker": "link:packages/element-picker",
    "@apad/rc-slider": "^10.5.0",
    "@apad/setting-panel": "^0.6.6",
    "@rc-component/trigger": "^3.10.1",
    "ahooks": "^3.9.7",
    "ass-compiler": "^0.1.16",
    "bilibili-live-ws": "^6.3.1",
    "classnames": "^2.5.1",
    "color": "^5.0.3",
    "fast-deep-equal": "^3.1.3",
    "mitt": "^3.0.1",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "node-html-parser": "^9.0.0",
    "pako": "^2.2.0",
    "preact": "^10.29.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.0",
    "react-hot-toast": "^2.6.0",
    "uuid": "^14.0.1",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.9.0",
    "ws": "^8.21.1"
  }
}
