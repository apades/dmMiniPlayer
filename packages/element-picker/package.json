{
  "name": "@apad/element-picker",
  "version": "0.1.0",
  "description": "Pick DOM elements from a page by clicking, with single and list modes",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "test": "playwright test",
    "prepublishOnly": "pnpm build",
    "release": "pnpm build && pnpm publish --access public"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "keywords": [
    "element-picker",
    "dom",
    "selector",
    "picker"
  ],
  "author": "apades",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.5"
  }
}